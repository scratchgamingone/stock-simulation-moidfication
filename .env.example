# Stock Market Simulation - Environment Variables

# Finnhub API Key (Get your free key at: https://finnhub.io/register)
# Free tier includes: 60 API calls/minute
REACT_APP_FINNHUB_API_KEY=your_api_key_here
# Optional aliases also supported by the app:
# REACT_APP_FINNHUB_KEY=your_api_key_here
# REACT_APP_STOCK_API_KEY=your_api_key_here

# Alternative: Alpha Vantage API Key (Get your free key at: https://www.alphavantage.co/support/#api-key)
# Free tier includes: 5 API calls/minute, 500 calls/day
# REACT_APP_ALPHA_VANTAGE_API_KEY=your_api_key_here
# Optional alias:
# REACT_APP_ALPHA_VANTAGE_KEY=your_api_key_here

# Alternative: Twelve Data API Key (Get your free key at: https://twelvedata.com/)
# Free tier availability may change over time (check provider docs)
# REACT_APP_TWELVE_DATA_API_KEY=your_api_key_here
# Optional alias:
# REACT_APP_TWELVE_DATA_KEY=your_api_key_here

# Alternative: Polygon.io API Key (Get your free key at: https://polygon.io/)
# Free tier availability may change over time (check provider docs)
# REACT_APP_POLYGON_API_KEY=your_api_key_here
# Optional alias:
# REACT_APP_POLYGON_KEY=your_api_key_here

# API Configuration
REACT_APP_USE_LIVE_DATA=false
REACT_APP_UPDATE_INTERVAL=60000

# After editing .env/.env.local, restart the dev server.
